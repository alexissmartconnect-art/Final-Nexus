# ---------------------------------------------------------------------------
# NEXUS OMEGA - environment template
# Copy to .env and fill in. NEVER commit .env. Secrets never reach the browser.
# ---------------------------------------------------------------------------

# --- Core ---
NEXUS_ENV=development
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8787
# Master key used to derive the secret-vault encryption key (AES-256-GCM).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXUS_MASTER_KEY=
# Where the SQLite database lives (control plane persistence).
NEXUS_DATA_DIR=./.nexus/data
NEXUS_MIGRATIONS_DIR=./database/migrations
# Isolated workspace root for Web Factory projects.
NEXUS_WORKSPACE_DIR=./.nexus/workspaces
# Comma separated list of origins allowed to call the API with credentials.
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bootstrap the first admin account on first boot (email:password). Empty = disabled.
NEXUS_BOOTSTRAP_ADMIN=

# --- Providers (server side only) ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=NEXUS OMEGA
HUGGINGFACE_TOKEN=

# --- Execution plane ---
NEXUS_RUNNER_MODE=local
NEXUS_RUNNER_URL=
NEXUS_RUNNER_TOKEN=
NEXUS_RUNNER_DEFAULT_TIMEOUT_MS=120000
